<?xml version="1.0"?>
<!--
	Flash GSI wizard for Infinix X695C (MT6785) — OrangeFox Recovery

	Injected post-build via fox_gsi_patch.yml workflow.
	Page hierarchy:
	  flash_gsi_select   — file picker for gsi.img
	  flash_gsi_info     — show file size + hash + target partition
	  flash_gsi_run      — execute gsi_run.sh via cmd action
	  flash_gsi_done     — success page with wipe prompt

	Prerequisites (already in ramdisk via device tree):
	  /sbin/gsi_run.sh    — main flasher script (auto-resize, validate, flash, wipe prompt)
	  /system/bin/lptools — provided via OF_ENABLE_LPTOOLS=1 in vendorsetup.sh

	Button to launch this wizard is injected into advanced.xml as a listitem.

	Style/variable references verified against OrangeFox theme (Toygoon mirror):
	  - Styles: text_ab_title, text_ab_subtitle, text_body1, caption, btn_raised,
	            btn_raised_hl, slider_action, fileselector_b, fileselector_s
	  - Vars:   col1_x_indent, col1_x_caption, ab_bc_y, ab_h, row1_2_y, row2_1a_y,
	            row2_2a_y, row3_1a_y, row3_2a_y, row4_1a_y, row4_2a_y,
	            btn_raised_left_x, btn_raised_right_x, row_btn1_y, row_btn2_y,
	            row_btn3_y, center_x, slider_y, slider_text_y, screen_w,
	            bl_fullscreen_h, col1_x_indent
	  - Templates: base_ex, base_console_cancel
-->
<recovery>
	<pages>

		<!-- Step 1: File picker — user selects gsi.img -->
		<page name="flash_gsi_select">
			<template name="base_ex"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>Flash GSI Image</text>
			</text>

			<text style="text_ab_subtitle">
				<placement x="%col1_x_indent%" y="%row1_2_y%"/>
				<text>Select a GSI image (.img) to flash to system_a</text>
			</text>

			<fileselector style="fileselector_b">
				<condition var1="list_font" var2="1"/>
				<placement x="0" y="%ab_h%" w="%screen_w%" h="%bl_fullscreen_h%"/>
				<sort name="0"/>
				<iconsize w="%col1_x_indent%" h="90" padding="25"/>
				<icon folder="folder_icon_small" file="file_icon_small" />
				<filter folders="y" files="y" nav="y"/>
				<path name="gsi_path" default="/sdcard"/>
				<data name="gsi_file"/>
				<selection name="gsi_select"/>
			</fileselector>

			<fileselector style="fileselector_s">
				<condition var1="list_font" op="!=" var2="1"/>
				<placement x="0" y="%ab_h%" w="%screen_w%" h="%bl_fullscreen_h%"/>
				<sort name="0"/>
				<iconsize w="%col1_x_indent%" h="90" padding="25"/>
				<icon folder="folder_icon_small" file="file_icon_small" />
				<filter folders="y" files="y" nav="y"/>
				<path name="gsi_path" default="/sdcard"/>
				<data name="gsi_file"/>
				<selection name="gsi_select"/>
			</fileselector>

			<!-- When user selects a file, set tw_file to full path and go to info page -->
			<action>
				<condition var1="gsi_select" op="!=" var2=""/>
				<action function="set">tw_file=%gsi_path%/%gsi_file%</action>
				<action function="page">flash_gsi_info</action>
			</action>

			<!-- Back key returns to advanced -->
			<action>
				<touch key="back"/>
				<action function="page">advanced</action>
			</action>
		</page>

		<!-- Step 2: Show file info + what will happen -->
		<page name="flash_gsi_info">
			<template name="base_ex"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>GSI Image Info</text>
			</text>

			<text style="caption">
				<placement x="%col1_x_caption%" y="%row2_1a_y%"/>
				<text>File</text>
			</text>
			<text style="text_body1">
				<placement x="%col1_x_caption%" y="%row2_2a_y%"/>
				<text>%tw_file%</text>
			</text>

			<text style="caption">
				<placement x="%col1_x_caption%" y="%row3_1a_y%"/>
				<text>Target partition</text>
			</text>
			<text style="text_body1">
				<placement x="%col1_x_caption%" y="%row3_2a_y%"/>
				<text>/dev/block/mapper/system_a (active slot)</text>
			</text>

			<text style="caption">
				<placement x="%col1_x_caption%" y="%row4_1a_y%"/>
				<text>Will be performed</text>
			</text>
			<text style="text_body1">
				<placement x="%col1_x_caption%" y="%row4_2a_y%"/>
				<text>1. Validate ext4 magic + min size 1.5GB
2. Verify SHA256 (if .sha256 file present)
3. Auto-resize system_a to 5GB via lptools
4. Flash GSI image to system_a
5. Prompt for factory reset (manual wipe)</text>
			</text>

			<!-- Swipe to confirm and proceed. Use slider_action style (real OrangeFox). -->
			<slider style="slider_action">
				<placement x="%center_x%" y="%slider_y%" placement="5"/>
				<action function="page">flash_gsi_run</action>
			</slider>

			<!-- Swipe hint text uses 'caption' style (matches OrangeFox install.xml pattern) -->
			<text style="caption">
				<placement x="%center_x%" y="%slider_text_y%" placement="5"/>
				<text>Swipe to start GSI flash</text>
			</text>

			<!-- Cancel button — uses standard OrangeFox btn_raised style + placement vars -->
			<button style="btn_raised">
				<placement x="%btn_raised_left_x%" y="%row_btn3_y%"/>
				<text>Cancel</text>
				<action function="page">advanced</action>
			</button>

			<action>
				<touch key="back"/>
				<action function="page">flash_gsi_select</action>
			</action>
		</page>

		<!-- Step 3: Execute gsi_run.sh via cmd action.
		     CRITICAL: cmd action must be single-line and quote the path argument
		     to handle filenames with spaces. The TWRP cmd() function passes the
		     whole arg string to system(), so we use sh -c style with single quotes. -->
		<page name="flash_gsi_run">
			<template name="base_console_cancel"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>Flashing GSI...</text>
			</text>

			<text style="text_ab_subtitle">
				<placement x="%col1_x_indent%" y="%row1_2_y%"/>
				<text>Do not reboot or disconnect power</text>
			</text>

			<!-- Run the script. Single quotes around %tw_file% handle spaces in path. -->
			<action function="cmd">/sbin/gsi_run.sh '%tw_file%'</action>

			<!-- On success (tw_operation_status=0), go to done page.
			     tw_operation_status is set by operation_end() in TWRP action.cpp. -->
			<action>
				<condition var1="tw_operation_state" var2="1"/>
				<condition var1="tw_operation_status" var2="0"/>
				<action function="page">flash_gsi_done</action>
			</action>

			<!-- On failure, stay on this page (console shows error output) -->
			<action>
				<condition var1="tw_operation_state" var2="1"/>
				<condition var1="tw_operation_status" var2="1"/>
				<action function="set">tw_action_text1=GSI flash failed — check console output above</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">flash_gsi_info</action>
			</action>
		</page>

		<!-- Step 4: Success page with wipe prompt.
		     Uses standard OrangeFox button pattern: <text> inside <button>,
		     btn_raised style, btn_raised_left_x / btn_raised_right_x / row_btnN_y vars. -->
		<page name="flash_gsi_done">
			<template name="base_ex"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>GSI Flash Complete</text>
			</text>

			<text style="text_body1">
				<placement x="%col1_x_caption%" y="%row2_2a_y%"/>
				<text>GSI image has been flashed to system_a successfully.

IMPORTANT: For GSI to boot properly, you MUST perform a factory reset now to remove vendor remnants that conflict with the new GSI.

Tap "Wipe Data" below to factory reset, or "Reboot" to skip wipe (not recommended).</text>
			</text>

			<!-- Wipe data button — left side, highlighted (recommended action) -->
			<button style="btn_raised_hl">
				<placement x="%btn_raised_left_x%" y="%row_btn1_y%"/>
				<text>Wipe Data (Recommended)</text>
				<action function="set">tw_back=flash_gsi_done</action>
				<action function="page">wipe</action>
			</button>

			<!-- Reboot button (skip wipe) — left side, row 2 -->
			<button style="btn_raised">
				<placement x="%btn_raised_left_x%" y="%row_btn2_y%"/>
				<text>Reboot System (Skip Wipe)</text>
				<action function="set">tw_back=flash_gsi_done</action>
				<action function="overlay">reboot</action>
			</button>

			<!-- Back to advanced — right side, row 2 -->
			<button style="btn_raised">
				<placement x="%btn_raised_right_x%" y="%row_btn2_y%"/>
				<text>Back to Advanced</text>
				<action function="page">advanced</action>
			</button>

			<action>
				<touch key="back"/>
				<action function="page">advanced</action>
			</action>
		</page>

	</pages>
</recovery>
