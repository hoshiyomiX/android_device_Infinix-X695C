<?xml version="1.0"?>
<!--
        Flash GSI wizard for Infinix X695C (MT6785) — OrangeFox Recovery

        Injected post-build via fox_gsi_patch.yml workflow.
        Page hierarchy:
          flash_gsi_select   — file picker for gsi.img
          flash_gsi_info     — show file size + hash + target partition
          flash_gsi_run      — execute gsi_run.sh via cmd action
          flash_gsi_done     — success page with wipe prompt

        Prerequisites (already in ramdisk via device tree):
          /sbin/gsi_run.sh    — main flasher script (auto-resize, validate, flash, wipe prompt)
          /system/bin/lptools — provided via OF_ENABLE_LPTOOLS=1 in vendorsetup.sh

        Button to launch this wizard is injected into advanced.xml as a listitem.

        R2 enhancements (wipe data checkbox + .img filter):
          - File selector filtered to .img extension only (native TWRP pattern:
            <filter extn=".img" .../> from install.xml)
          - Optional wipe data checkbox on flash_gsi_info page (default OFF).
            Uses native TWRP 2-button checkbox pattern (checkbox_true/false
            with condition-controlled visibility). If checked, wizard navigates
            to TWRP native wipe page after successful flash (tw_back=done).
          - gsi_wipe_data variable lifecycle:
              init=0 on flash_gsi_select entry (default OFF)
              toggle on flash_gsi_info (checkbox)
              read on flash_gsi_run success (route to wipe or done)
              cleared on flash_gsi_done entry (cleanup for next run)

        Style/variable references verified against OrangeFox theme (Toygoon mirror):
          - Styles: text_ab_title, text_ab_subtitle, text_body1, caption, btn_raised,
                    btn_raised_hl, slider_action, fileselector_b, fileselector_s
          - Vars:   col1_x_indent, col1_x_caption, ab_bc_y, ab_h, row1_2_y, row2_1a_y,
                    row2_2a_y, row3_1a_y, row3_2a_y, row4_1a_y, row4_2a_y,
                    btn_raised_left_x, btn_raised_right_x, row_btn1_y, row_btn2_y,
                    row_btn3_y, center_x, slider_y, slider_text_y, screen_w,
                    bl_fullscreen_h, col1_x_indent
          - Templates: base_ex, base_console_cancel
-->
<recovery>
        <pages>

                <!-- Step 1: File picker — user selects gsi.img.
                     R6 fix: Rewrote using OrangeFox native add_zip page template
                     (from install.xml line 566). Previous version used custom
                     <iconsize>, hardcoded <sort name="0"/>, small icons, and
                     non-standard placement vars — caused file picker to render
                     blank. Native template uses standard vars + no iconsize +
                     user-driven sort + full-size icons.

                     Pattern copied from:
                       gui/theme/portrait_hdpi/pages/install.xml page "add_zip"
                     Changes for GSI:
                       - filter extn=".img" (was ".zip;.ozip")
                       - selection/data/path names: tw_gsi_* (was tw_zip_*/tw_filename_*)
                       - navigate to flash_gsi_info (was flash_confirm)
                       - back → advanced (was flash_confirm)
                       - init gsi_wipe_data=0 on entry (R2 wipe checkbox reset) -->
                <page name="flash_gsi_select">
                        <fileselector style="fileselector_b">
                                <condition var1="list_font" var2="1"/>
                                <placement x="0" y="%row_ab_ex_y%" w="%fileselector_width%" h="%fileselector_terminal_height%"/>
                                <sort name="tw_gui_sort_order"/>
                                <icon folder="folder_icon" file="file_icon"/>
                                <filter extn=".img" folders="1" files="1"/>
                                <path name="tw_gsi_location" default="/sdcard"/>
                                <data name="tw_gsi_filename"/>
                                <selection name="tw_gsi_file"/>
                        </fileselector>

                        <fileselector style="fileselector_s">
                                <condition var1="list_font" op="!=" var2="1"/>
                                <placement x="0" y="%row_ab_ex_y%" w="%fileselector_width%" h="%fileselector_terminal_height%"/>
                                <sort name="tw_gui_sort_order"/>
                                <icon folder="folder_icon_small" file="file_icon_small"/>
                                <filter extn=".img" folders="1" files="1"/>
                                <path name="tw_gsi_location" default="/sdcard"/>
                                <data name="tw_gsi_filename"/>
                                <selection name="tw_gsi_file"/>
                        </fileselector>

                        <template name="base_ex"/>

                        <!-- R2: Initialize wipe_data to 0 (default OFF) on page entry.
                             Resets checkbox state when user re-enters wizard. -->
                        <action>
                                <action function="set">gsi_wipe_data=0</action>
                        </action>

                        <text style="text_ab_title">
                                <placement x="%col1_x_indent%" y="%ab_bc_y%"/>
                                <text>Flash GSI Image</text>
                        </text>

                        <template name="actionbar_sort"/>
                        <template name="actionbar_storage"/>

                        <text style="text_ab_title">
                                <placement x="%col1_x_indent%" y="%row1_2_y%" placement="2"/>
                                <text>Select GSI Image</text>
                        </text>

                        <text style="text_ab_subtitle_lim">
                                <placement x="%col1_x_indent%" y="%row1_2_y%"/>
                                <text>%tw_gsi_location%</text>
                        </text>

                        <!-- R5 fix: op="modified" — fires ONLY when user taps a file
                             (not on every page render). Matches OrangeFox native
                             add_zip pattern (install.xml line 608). -->
                        <action>
                                <condition var1="tw_gsi_filename" op="modified"/>
                                <action function="set">tw_file=%tw_gsi_file%</action>
                                <action function="page">flash_gsi_info</action>
                        </action>

                        <template name="gestures"/>

                        <action>
                                <touch key="back"/>
                                <action function="page">advanced</action>
                        </action>

                        <action>
                                <touch key="home"/>
                                <action function="page">main</action>
                        </action>
                </page>

                <!-- Step 2: Show file info + what will happen -->
                <page name="flash_gsi_info">
                        <template name="base_ex"/>

                        <text style="text_ab_title">
                                <placement x="%col1_x_indent%" y="%ab_bc_y%"/>
                                <text>GSI Image Info</text>
                        </text>

                        <text style="caption">
                                <placement x="%col1_x_caption%" y="%row2_1a_y%"/>
                                <text>File</text>
                        </text>
                        <text style="text_body1">
                                <placement x="%col1_x_caption%" y="%row2_2a_y%"/>
                                <text>%tw_file%</text>
                        </text>

                        <text style="caption">
                                <placement x="%col1_x_caption%" y="%row3_1a_y%"/>
                                <text>Target partition</text>
                        </text>
                        <text style="text_body1">
                                <placement x="%col1_x_caption%" y="%row3_2a_y%"/>
                                <text>/dev/block/mapper/system_a (active slot)</text>
                        </text>

                        <text style="caption">
                                <placement x="%col1_x_caption%" y="%row4_1a_y%"/>
                                <text>Will be performed</text>
                        </text>
                        <text style="text_body1">
                                <placement x="%col1_x_caption%" y="%row4_2a_y%"/>
                                <text>1. Validate ext4 magic + min size 1.5GB
2. Verify SHA256 (if .sha256 file present)
3. Smart resize system_a to GSI+200MB (1.7-6GB)
   If super is full, shrink system_ext+product
   (vendor is never touched)
4. Flash GSI image to system_a</text>
                        </text>

                        <!-- R2: Optional wipe data checkbox (default OFF).
                             Native TWRP checkbox pattern: 2 overlapping buttons,
                             one for unchecked (checkbox_false→set 1), one for checked
                             (checkbox_true→set 0). Condition controls visibility.
                             textplacement=6 = text to right of checkbox icon.
                             Placement: row_btn2_y (above cancel button at row_btn3_y). -->
                        <button style="checkbox">
                                <condition var1="gsi_wipe_data" op="!=" var2="1"/>
                                <placement x="%col1_x_caption%" y="%row_btn2_y%" textplacement="6"/>
                                <text>Wipe data after flash (factory reset)</text>
                                <image resource="checkbox_false"/>
                                <action function="set">gsi_wipe_data=1</action>
                        </button>

                        <button style="checkbox">
                                <condition var1="gsi_wipe_data" var2="1"/>
                                <placement x="%col1_x_caption%" y="%row_btn2_y%" textplacement="6"/>
                                <text>Wipe data after flash (factory reset)</text>
                                <image resource="checkbox_true"/>
                                <action function="set">gsi_wipe_data=0</action>
                        </button>

                        <!-- Swipe to confirm and proceed. Use slider_action style (real OrangeFox). -->
                        <slider style="slider_action">
                                <placement x="%center_x%" y="%slider_y%" placement="5"/>
                                <action function="page">flash_gsi_run</action>
                        </slider>

                        <!-- Swipe hint text uses 'caption' style (matches OrangeFox install.xml pattern) -->
                        <text style="caption">
                                <placement x="%center_x%" y="%slider_text_y%" placement="5"/>
                                <text>Swipe to start GSI flash</text>
                        </text>

                        <!-- Cancel button — uses standard OrangeFox btn_raised style + placement vars -->
                        <button style="btn_raised">
                                <placement x="%btn_raised_left_x%" y="%row_btn3_y%"/>
                                <text>Cancel</text>
                                <action function="page">advanced</action>
                        </button>

                        <action>
                                <touch key="back"/>
                                <action function="page">flash_gsi_select</action>
                        </action>
                </page>

                <!-- Step 3: Execute gsi_run.sh via cmd action.
                     CRITICAL: cmd action must be single-line and quote the path argument
                     to handle filenames with spaces. The TWRP cmd() function passes the
                     whole arg string to system(), so we use sh -c style with single quotes. -->
                <page name="flash_gsi_run">
                        <template name="base_console_cancel"/>

                        <text style="text_ab_title">
                                <placement x="%col1_x_indent%" y="%ab_bc_y%"/>
                                <text>Flashing GSI...</text>
                        </text>

                        <text style="text_ab_subtitle">
                                <placement x="%col1_x_indent%" y="%row1_2_y%"/>
                                <text>Do not reboot or disconnect power</text>
                        </text>

                        <!-- Run the script. Single quotes around %tw_file% handle spaces in path.
                             M1 note: filename must NOT contain single quotes, backticks, or $ —
                                     the script will reject these in its usage text.
                                     M3 fix: guard with tw_busy=0 so re-entry (user swipes again after
                                     returning to this page) does NOT trigger a second dd flash. -->
                        <action>
                                <condition var1="tw_busy" var2="0"/>
                                <action function="cmd">/sbin/gsi_run.sh '%tw_file%'</action>
                        </action>

                        <!-- On success (tw_operation_status=0), route based on gsi_wipe_data.
                             R2: if user checked wipe_data, go to TWRP native wipe page
                             (tw_back=flash_gsi_done so user returns to done page after wipe).
                             If unchecked, go straight to done page. -->
                        <action>
                                <condition var1="tw_operation_state" var2="1"/>
                                <condition var1="tw_operation_status" var2="0"/>
                                <condition var1="gsi_wipe_data" var2="1"/>
                                <action function="set">tw_back=flash_gsi_done</action>
                                <action function="page">wipe</action>
                        </action>

                        <action>
                                <condition var1="tw_operation_state" var2="1"/>
                                <condition var1="tw_operation_status" var2="0"/>
                                <condition var1="gsi_wipe_data" op="!=" var2="1"/>
                                <action function="page">flash_gsi_done</action>
                        </action>

                        <!-- On failure, stay on this page (console shows error output) -->
                        <action>
                                <condition var1="tw_operation_state" var2="1"/>
                                <condition var1="tw_operation_status" var2="1"/>
                                <action function="set">tw_action_text1=GSI flash failed — check console output above</action>
                        </action>

                        <action>
                                <touch key="back"/>
                                <action function="page">flash_gsi_info</action>
                        </action>
                </page>

                <!-- Step 4: Success page with wipe prompt.
                     Uses standard OrangeFox button pattern: <text> inside <button>,
                     btn_raised style, btn_raised_left_x / btn_raised_right_x / row_btnN_y vars. -->
                <page name="flash_gsi_done">
                        <template name="base_ex"/>

                        <text style="text_ab_title">
                                <placement x="%col1_x_indent%" y="%ab_bc_y%"/>
                                <text>GSI Flash Complete</text>
                        </text>

                        <text style="text_body1">
                                <placement x="%col1_x_caption%" y="%row2_2a_y%"/>
                                <text>GSI image has been flashed to system_a successfully.

If you did not enable "Wipe data after flash" earlier, it is
recommended to wipe now to remove vendor remnants that conflict
with the new GSI.

Tap "Wipe Data" below for factory reset, or "Reboot System"
to boot into the new GSI.</text>
                        </text>

                        <!-- M5 fix: clear tw_file on page load so re-entering the wizard
                             does not auto-select the previous GSI image.
                             R2: also clear gsi_wipe_data so checkbox resets for next run. -->
                        <action>
                                <action function="set">tw_file=</action>
                                <action function="set">gsi_select=</action>
                                <action function="set">gsi_file=</action>
                                <action function="set">gsi_wipe_data=0</action>
                        </action>

                        <!-- Wipe data button — left side, highlighted (recommended action) -->
                        <button style="btn_raised_hl">
                                <placement x="%btn_raised_left_x%" y="%row_btn1_y%"/>
                                <text>Wipe Data (Recommended)</text>
                                <action function="set">tw_back=flash_gsi_done</action>
                                <action function="page">wipe</action>
                        </button>

                        <!-- Reboot button (skip wipe) — left side, row 2 -->
                        <button style="btn_raised">
                                <placement x="%btn_raised_left_x%" y="%row_btn2_y%"/>
                                <text>Reboot System (Skip Wipe)</text>
                                <action function="set">tw_back=flash_gsi_done</action>
                                <action function="overlay">reboot</action>
                        </button>

                        <!-- Back to advanced — right side, row 2 -->
                        <button style="btn_raised">
                                <placement x="%btn_raised_right_x%" y="%row_btn2_y%"/>
                                <text>Back to Advanced</text>
                                <action function="page">advanced</action>
                        </button>

                        <action>
                                <touch key="back"/>
                                <action function="page">advanced</action>
                        </action>
                </page>

        </pages>
</recovery>
